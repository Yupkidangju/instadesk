{
  "name": "instabox-deck",
  "private": true,
  "version": "2.1.1",
  "productName": "InstaDesk",
  "author": "Yupkidangju <yupkidangju@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run desktop:dev",
    "build": "npm run build:desktop",
    "build:renderer": "vite build",
    "build:desktop": "npm run typecheck && npm run build:renderer && node scripts/build-electron.mjs",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:start": "electron .",
    "desktop:install": "install-electron",
    "package:win": "npm run build:desktop && node scripts/package-win.mjs",
    "package:linux": "npm run build:desktop && node scripts/package-linux.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.22.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
